// Schema Prisma — ERP Clínica (erp-karine)
//
// Convenções gerais (ver ARCHITECTURE.md):
//  - Identificadores: UUID (`String @id @default(uuid())`)
//  - Dinheiro: sempre em CENTAVOS (`Int`) — SQLite não tem tipo decimal exato
//  - Histórico: inativação/soft delete (`active`, `deletedAt`, `status`), nunca DELETE físico
//  - Enums declarados aqui; o conector SQLite os materializa como TEXT (sem CHECK),
//    então a validação real acontece no DTO (class-validator) e no Prisma Client
//
// Cada entidade pertence a um único módulo (ver MODULES.md). Nenhum módulo deve
// consultar tabelas de outro módulo diretamente — usa o serviço público do dono.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AppointmentStatus {
  AGENDADO
  CONFIRMADO
  REALIZADO
  CANCELADO
  FALTOU
}

enum SubscriptionStatus {
  ATIVA
  CANCELADA
  ENCERRADA
  INADIMPLENTE
}

enum Periodicity {
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
  OUTRO
}

enum TransactionOrigin {
  APPOINTMENT
  SUBSCRIPTION
  MANUAL
}

enum ExamStatus {
  RECOMENDADO
  REALIZADO
  CANCELADO
}

// ---------------------------------------------------------------------------
// Módulo: clients
// ---------------------------------------------------------------------------

/// Usuário do sistema (equipe da clínica). Roles reservadas para uso futuro.
model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(ADMIN)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sessions           Session[]

  @@index([active])
}

/// Sessão de login. O token vai ao cliente em cookie httpOnly; aqui fica só o hash.
model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  ADMIN
  USER
}

model Client {
  id            String    @id @default(uuid())
  fullName      String
  cpf           String?   @unique
  birthDate     DateTime?
  phone         String?
  whatsapp      String?
  email         String?
  address       String?
  notes         String?
  active        Boolean   @default(true)
  deactivatedAt DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments        Appointment[]
  subscriptions       ClientSubscription[]
  transactions        FinancialTransaction[]
  protocols           Protocol[]
  examRecommendations ExamRecommendation[]

  @@index([fullName])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Módulo: procedures
// ---------------------------------------------------------------------------

/// Unidade de medida do procedimento: é por ela que o valor unitário é cobrado.
enum ProcedureUnit {
  SESSAO
  APLICACAO
  REGIAO
  ML
  UNIDADE
  HORA
  PACOTE
}

model Procedure {
  id              String        @id @default(uuid())
  name            String        @unique
  description     String?
  unit            ProcedureUnit @default(SESSAO)
  durationMinutes Int?
  active          Boolean       @default(true)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointments Appointment[]
  prices       ProcedurePrice[]

  @@index([active])
}

/// Vigência de valor de um procedimento.
///
/// O preço vale de `validFrom` (inclusive) até `validTo` (exclusivo).
/// `validTo = null` significa "vigência atual, em aberto". O histórico nunca é
/// reescrito: mudar o preço cria uma vigência nova e fecha a anterior, para
/// preservar a série histórica.
model ProcedurePrice {
  id          String    @id @default(uuid())
  procedureId String
  valueCents  Int
  validFrom   DateTime  @db.Date
  validTo     DateTime? @db.Date
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([procedureId, validFrom])
  @@index([procedureId, validFrom])
}

// ---------------------------------------------------------------------------
// Módulo: appointments
// ---------------------------------------------------------------------------

model Appointment {
  id             String            @id @default(uuid())
  clientId       String
  procedureId    String?
  professional   String?
  scheduledAt    DateTime
  status         AppointmentStatus @default(AGENDADO)
  notes          String?
  // Snapshot comercial: nunca recalcular atendimento antigo pelo cadastro atual.
  procedureName  String?
  procedureUnit  ProcedureUnit?
  quantity       Int               @default(1)
  unitValueCents Int               @default(0)
  valueCents     Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  client               Client                @relation(fields: [clientId], references: [id])
  procedure            Procedure?            @relation(fields: [procedureId], references: [id])
  financialTransaction FinancialTransaction?

  @@index([clientId])
  @@index([scheduledAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Módulo: subscriptions
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id                String      @id @default(uuid())
  name              String      @unique
  description       String?
  priceCents        Int         @default(0)
  periodicity       Periodicity @default(MENSAL)
  sessionsPerPeriod Int?
  active            Boolean     @default(true)
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  subscriptions ClientSubscription[]

  @@index([active])
}

model ClientSubscription {
  id                    String             @id @default(uuid())
  clientId              String
  planId                String
  startDate             DateTime
  endDate               DateTime?
  contractedValueCents  Int                @default(0)
  // Snapshot do plano contratado: alterações futuras no catálogo não mudam o histórico.
  planName              String             @default("")
  planPeriodicity       Periodicity        @default(MENSAL)
  planSessionsPerPeriod Int?
  paymentMethod         PaymentMethod      @default(PIX)
  status                SubscriptionStatus @default(ATIVA)
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  client Client           @relation(fields: [clientId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  payments     SubscriptionPayment[]
  transactions FinancialTransaction[]

  @@index([clientId])
  @@index([planId])
  @@index([status])
}

model SubscriptionPayment {
  id             String        @id @default(uuid())
  subscriptionId String
  amountCents    Int           @default(0)
  paidAt         DateTime
  paymentMethod  PaymentMethod @default(PIX)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription         ClientSubscription    @relation(fields: [subscriptionId], references: [id])
  financialTransaction FinancialTransaction?

  @@index([subscriptionId])
  @@index([paidAt])
}

// ---------------------------------------------------------------------------
// Módulo: financial
// ---------------------------------------------------------------------------

model FinancialTransaction {
  id                    String            @id @default(uuid())
  clientId              String?
  description           String
  category              String?
  amountCents           Int               @default(0)
  date                  DateTime
  paymentMethod         PaymentMethod     @default(PIX)
  origin                TransactionOrigin @default(MANUAL)
  // Vínculos tipados por origem (únicos): impedem faturar o mesmo atendimento
  // ou o mesmo pagamento de assinatura duas vezes.
  appointmentId         String?           @unique
  subscriptionId        String?
  subscriptionPaymentId String?           @unique
  // Referência externa livre (ex.: id do sistema de origem, conciliação manual)
  externalReference     String?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  client              Client?              @relation(fields: [clientId], references: [id])
  appointment         Appointment?         @relation(fields: [appointmentId], references: [id])
  subscription        ClientSubscription?  @relation(fields: [subscriptionId], references: [id])
  subscriptionPayment SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id])

  @@index([clientId])
  @@index([date])
  @@index([origin])
}

// ---------------------------------------------------------------------------
// Módulo: protocols
// ---------------------------------------------------------------------------

model Protocol {
  id               String    @id @default(uuid())
  clientId         String
  date             DateTime
  title            String
  chiefComplaint   String?
  evaluation       String?
  objective        String?
  proposedProtocol String?
  productsUsed     String?
  guidelines       String?
  evolution        String?
  notes            String?
  active           Boolean   @default(true)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client   Client            @relation(fields: [clientId], references: [id])
  sessions ProtocolSession[]

  @@index([clientId])
  @@index([date])
}

model ProtocolSession {
  id                 String   @id @default(uuid())
  protocolId         String
  date               DateTime
  procedurePerformed String
  productsUsed       String?
  parameters         String?
  notes              String?
  evolution          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  protocol Protocol @relation(fields: [protocolId], references: [id])

  @@index([protocolId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Módulo: exams
// ---------------------------------------------------------------------------

model ExamRecommendation {
  id            String     @id @default(uuid())
  clientId      String
  date          DateTime
  justification String?
  notes         String?
  status        ExamStatus @default(RECOMENDADO)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  client Client                   @relation(fields: [clientId], references: [id])
  items  ExamRecommendationItem[]

  @@index([clientId])
  @@index([date])
  @@index([status])
}

model ExamRecommendationItem {
  id               String   @id @default(uuid())
  recommendationId String
  examName         String
  notes            String?
  createdAt        DateTime @default(now())

  recommendation ExamRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
}
