# Banco de dados — PostgreSQL.
# Produção (dentro do CapRover, via rede overlay): srv-captain--postgresql:5432
# Desenvolvimento local: use o host/IP que a sua máquina alcança.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/erp_estetica"

# Porta da API
PORT=3001

# Origens liberadas para o frontend em desenvolvimento (separadas por vírgula)
CORS_ORIGINS="http://localhost:5173"

# ---------------------------------------------------------------------------
# Infra disponível no CapRover — o sistema ainda NÃO usa.
# ---------------------------------------------------------------------------
# Redis (cache/sessão):
# REDIS_URL="redis://default:SENHA@srv-captain--redis:6379/0"
#
# MinIO / S3 (fotos e fichas de pacientes):
# MINIO_ENDPOINT="https://storage-api.solucoes.cloud"
# MINIO_REGION="eu-east-1"
# MINIO_ACCESS_KEY=""
# MINIO_SECRET_KEY=""
# MINIO_BUCKET="erp-estetica"
